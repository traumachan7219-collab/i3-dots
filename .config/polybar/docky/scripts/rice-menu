#!/usr/bin/env bash
set -uo pipefail

RICE="/home/cool/.config/polybar/docky/scripts/rice-switch.sh"

themes=(
  "pink"
  "cyan"
  "orange"
  "red"
  "blue"
  "green"
  "purple"
  "black"
  "manga"
)

colors=(
  "#d81b60"
  "#00acc1"
  "#ff8c00"
  "#dc143c"
  "#1e88e5"
  "#43a047"
  "#bf5af2"
  "#000000"
  "#F5F0E0"
)

for i in "${!themes[@]}"; do
  c="${colors[$i]}"
  r=$((16#${c:1:2}))
  g=$((16#${c:3:2}))
  b=$((16#${c:5:2}))
  printf '\033[38;2;%d;%d;%dm■\033[0m %s\n' "$r" "$g" "$b" "${themes[$i]}"
done | /usr/bin/fzf --ansi --prompt="Theme > " --height=12 --reverse > /tmp/rice_choice || true

selected=$(cat /tmp/rice_choice 2>/dev/null)
[[ -z "$selected" ]] && exit 0

theme="${selected##* }"
exec /usr/bin/env bash "$RICE" "$theme"
