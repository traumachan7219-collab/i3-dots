[global]
    width = 600
    height = 600
    offset = 20x30
    origin = bottom-right
    background_opacity = 0.54
    dynamic_background_opacity = yes

    frame_width = 2
    frame_color = "#f5c2e7"
    font = Fira Code Retina 10
    corner_radius = 4

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 5

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 7

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#f5c2e7"
    timeout = 0
