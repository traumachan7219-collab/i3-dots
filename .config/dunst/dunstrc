[global]
    width = 600
    height = 600
    offset = 20x30
    origin = bottom-right
    background_opacity = 0.54
    dynamic_background_opacity = yes

    frame_width = 2
    frame_color = "#7aa2f7"
    font = Fira Code Retina 10
    corner_radius = 4

[urgency_low]
    background = "#24283b"
    foreground = "#c0caf5"
    timeout = 5

[urgency_normal]
    background = "#24283b"
    foreground = "#c0caf5"
    timeout = 7

[urgency_critical]
    background = "#24283b"
    foreground = "#c0caf5"
    frame_color = "#7aa2f7"
    timeout = 0
