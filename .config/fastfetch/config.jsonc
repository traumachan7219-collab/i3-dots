        { "type": "custom", "format": "" },

        {
            "type": "custom",
            "format": " \u001b[38;2;122;162;247m\u001b[48;2;122;162;247m\u001b[37m\u001b[1m SOFTWARE\u001b[0m\u001b[38;2;122;162;247m\u001b[0m"
        },
        { "type": "terminal", "key": "  Terminal" },
        { "type": "custom", "format": "" },

