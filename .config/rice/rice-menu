#!/usr/bin/env bash
set -uo pipefail

RICE="/home/cool/.config/rice/rice-switch.sh"

themes=(
  "pink"
  "cyan"
  "orange"
  "red"
  "blue"
  "green"
  "purple"
  "black"
  "gray"
  "yellow"
  "teal"
  "lavender"
  "mint"
  "nord"
  "dracula"
  "catppuccin"
  "gruvbox"
  "manga"
  "manga-page"
  "manga-pastel"
)

colors=(
  "#d81b60"
  "#00acc1"
  "#ff8c00"
  "#dc143c"
  "#1e88e5"
  "#43a047"
  "#bf5af2"
  "#000000"
  "#9E9E9E"
  "#fdd835"
  "#00897b"
  "#9575cd"
  "#66bb6a"
  "#88c0d0"
  "#FF5555"
  "#f5c2e7"
  "#d65d0e"
  "#fd4e4e"
  "#1A1A1A"
  "#7EC8E3"
)

for i in "${!themes[@]}"; do
  c="${colors[$i]}"
  r=$((16#${c:1:2}))
  g=$((16#${c:3:2}))
  b=$((16#${c:5:2}))
  printf '\033[38;2;%d;%d;%dm■\033[0m %s\n' "$r" "$g" "$b" "${themes[$i]}"
done | /usr/bin/fzf --ansi --prompt="Theme > " --height=20 --reverse > /tmp/rice_choice || true

selected=$(cat /tmp/rice_choice 2>/dev/null)
[[ -z "$selected" ]] && exit 0

theme="${selected##* }"
exec /usr/bin/env bash "$RICE" "$theme"
