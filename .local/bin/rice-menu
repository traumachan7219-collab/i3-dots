#!/usr/bin/env bash
set -euo pipefail

RICE="$HOME/.config/polybar/docky/scripts/rice-switch.sh"

themes=(
  "pink"
  "cyan"
  "orange"
  "red"
  "blue"
  "green"
  "purple"
  "black"
)

colors=(
  "#d81b60"
  "#00acc1"
  "#ff8c00"
  "#dc143c"
  "#1e88e5"
  "#43a047"
  "#bf5af2"
  "#000000"
)

entries=()
for i in "${!themes[@]}"; do
  c="${colors[$i]}"
  r=$((16#${c:1:2}))
  g=$((16#${c:3:2}))
  b=$((16#${c:5:2}))
  entries+=("$(printf '\033[38;2;%d;%d;%dm■\033[0m %s' "$r" "$g" "$b" "${themes[$i]}")")
done

selected=$(printf '%s\n' "${entries[@]}" | fzf --ansi --prompt="Theme > " --height=12 --reverse)

[[ -z "$selected" ]] && exit 0

theme=$(printf '%s' "$selected" | sed 's/.*\x1b\[0m //')
bash "$RICE" "$theme"
